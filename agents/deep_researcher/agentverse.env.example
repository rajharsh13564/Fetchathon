# Agentverse Deployment Configuration for DeepResearcher
# Copy this to .env in Agentverse secrets or set as environment variables

# Required: Agent seed (generate a unique one for production)
DEEP_RESEARCHER_SEED=your_unique_deep_researcher_seed_here

# Required: Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model
GEMINI_MODEL=gemini-1.5-flash

# Optional: Research Prompt
FINPILOT_RESEARCH_PROMPT=You are a senior equity research analyst specializing in Indian markets. Provide thorough, balanced analysis with clear bull and bear cases. Cite specific financial metrics and business fundamentals. Distinguish verified data from estimates and opinions.

# Optional: Mailbox Key (for hosted agent)
DEEP_RESEARCHER_MAILBOX_KEY=your_mailbox_key_from_agentverse

# Optional: Model Parameters
DEEP_RESEARCHER_TEMPERATURE=0.3
DEEP_RESEARCHER_MAX_TOKENS=8192
DEEP_RESEARCHER_TIMEOUT=60