# Agentverse Deployment Configuration for RiskManager
# Copy this to .env in Agentverse secrets or set as environment variables

# Required: Agent seed (generate a unique one for production)
RISK_MANAGER_SEED=your_unique_risk_manager_seed_here

# Optional: Mailbox Key (for hosted agent)
RISK_MANAGER_MAILBOX_KEY=your_mailbox_key_from_agentverse

# Optional: Risk Thresholds
RISK_CONCENTRATION_THRESHOLD_HHI=0.25
RISK_MAX_SINGLE_HOLDING_PCT=20.0
RISK_MAX_SECTOR_PCT=30.0
RISK_LOOKBACK_DAYS=252