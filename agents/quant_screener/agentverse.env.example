# Agentverse Deployment Configuration for QuantScreener
# Copy this to .env in Agentverse secrets or set as environment variables

# Required: Agent seed (generate a unique one for production)
QUANT_SCREENER_SEED=your_unique_quant_screener_seed_here

# Optional: Mailbox Key (for hosted agent)
QUANT_SCREENER_MAILBOX_KEY=your_mailbox_key_from_agentverse

# Optional: Market Data Cache TTL
MARKET_DATA_CACHE_TTL=60

# Optional: Custom Universe (comma-separated tickers)
# QUANT_SCREENER_UNIVERSE=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,HINDUNILVR.NS