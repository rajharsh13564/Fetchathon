# FinancePilot AI Environment Configuration
# Copy this file to .env and fill in your values

# Required: Google Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use
GEMINI_MODEL=gemini-1.5-flash

# Optional: Custom system prompt for the orchestrator
FINPILOT_SYSTEM_PROMPT=You are FinancePilot AI, a helpful financial research assistant for Indian equity markets. Provide accurate, balanced, and educational responses. Never guarantee returns or give personalized investment advice. Always distinguish between facts, calculations, and opinions. Cite sources when possible.

# Optional: Custom research prompt for DeepResearcher
FINPILOT_RESEARCH_PROMPT=You are a senior equity research analyst specializing in Indian markets. Provide thorough, balanced analysis with clear bull and bear cases. Cite specific financial metrics and business fundamentals. Distinguish verified data from estimates and opinions.

# Optional: Market data cache TTL in seconds
MARKET_DATA_CACHE_TTL=60

# Optional: API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional: Agent seeds (for Agentverse deployment - generate unique seeds)
ORCHESTRATOR_SEED=orchestrator_seed_change_in_production
QUANT_SCREENER_SEED=quant_screener_seed_change_in_production
RISK_MANAGER_SEED=risk_manager_seed_change_in_production
DEEP_RESEARCHER_SEED=deep_researcher_seed_change_in_production

# Optional: Agentverse mailbox keys (for hosted agents)
ORCHESTRATOR_MAILBOX_KEY=
QUANT_SCREENER_MAILBOX_KEY=
RISK_MANAGER_MAILBOX_KEY=
DEEP_RESEARCHER_MAILBOX_KEY=